rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    // 1. Users collection
    match /users/{uid} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == uid;
      allow update: if isOwner(uid) || isAdmin();
      allow delete: if isOwner(uid) || isAdmin();
    }

    // 2. Patients collection
    match /patients/{uid} {
      allow read: if isOwner(uid) || isDoctor() || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    // 3. Medical Profiles collection - STRICT PRIVACY SCOPING
    match /medicalProfiles/{patientUid} {
      // Patient can read/write own medical profile
      allow read, write: if isOwner(patientUid) || isAdmin();
      
      // Doctor can ONLY read medical profile if authorized and active appointment exists
      allow read: if isDoctor() && resource.data.shareProfileWithDoctor == true;
    }

    // 4. Doctors collection
    match /doctors/{doctorId} {
      allow read: if true; // Public directory for patients searching doctors
      allow create: if isAuthenticated() && (request.auth.uid == request.resource.data.userId || isAdmin());
      allow update: if isAuthenticated() && (request.auth.uid == resource.data.userId || isAdmin());
      allow delete: if isAdmin();
    }

    // 5. Hospitals collection
    match /hospitals/{hospitalId} {
      allow read: if true; // Public hospital search
      allow write: if isAdmin();
    }

    // 6. Appointments collection - Server Transactional Guard
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId ||
        isAdmin()
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.patientId;
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.patientId ||
        request.auth.uid == resource.data.doctorId ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // 7. First-Aid Articles collection
    match /firstAidArticles/{articleId} {
      allow read: if true; // Educational access
      allow write: if isAdmin();
    }

    // 8. AI Conversations & Messages
    match /aiConversations/{conversationId} {
      allow read, write: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read, write: if isAuthenticated();
      }
    }

    // 9. Notifications collection
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 10. Audit Logs collection
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }
  }
}
