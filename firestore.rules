rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authorization
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users collection
    match /users/{uid} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isOwner(uid);
    }

    // 2. Patients collection
    match /patients/{uid} {
      allow read, write: if true;
    }

    // 3. Medical Profiles collection
    match /medicalProfiles/{patientUid} {
      allow read, write: if true;
    }

    // 4. Doctors collection
    match /doctors/{doctorId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // 5. Hospitals collection
    match /hospitals/{hospitalId} {
      allow read: if true;
      allow write: if true;
    }

    // 6. Appointments collection
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // 7. First-Aid Articles collection
    match /firstAidArticles/{articleId} {
      allow read: if true;
      allow write: if true;
    }

    // 8. AI Conversations & Messages
    match /aiConversations/{conversationId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // 9. Notifications collection
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // 10. Audit Logs collection
    match /auditLogs/{logId} {
      allow read, write: if true;
    }
  }
}
